# ============================================================
# Health Diagnostics AI v3.0 — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ============================================================
# API KEYS SUMMARY
# ============================================================
# You need at most 3 API keys. All are free (no billing/credit card).
#
# KEY              | REQUIRED? | WHAT IT UNLOCKS
# -----------------|-----------|----------------------------------------
# GROQ_API_KEY     | Recommended | Diagnosis Agent, Risk Agent, Chat Agent
# GEMINI_API_KEY   | Recommended | Extraction Agent, Nutrition Agent
# NVIDIA_API_KEY   | Optional    | Better OCR accuracy on scanned PDFs
#
# IMPORTANT: One API key per provider gives access to ALL models.
# - 1 GROQ_API_KEY   → Llama 3.1, Mixtral, Gemma (all models)
# - 1 GEMINI_API_KEY  → Gemini 2.0 Flash, 1.5 Flash, 1.5 Pro (all models)
#
# The app works with ZERO API keys (rule-based fallback only).
# ============================================================

# ── Groq LLM (RECOMMENDED) ────────────────────────────────
# Sign up: https://console.groq.com/keys
# Free tier: 30 req/min, 14,400 req/day
# Used by: Diagnosis Agent, Risk Agent, Conversational (Chat) Agent
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Larger model for the Risk Agent (organ-system reasoning):
GROQ_RISK_MODEL=openai/gpt-oss-120b

# ── Google Gemini (RECOMMENDED) ───────────────────────────
# Sign up: https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1,500 req/day
# Used by: Extraction Agent, Nutrition Agent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── NVIDIA OCR (OPTIONAL — improves OCR accuracy) ─────────
# Sign up: https://build.nvidia.com
# Used by: OCR Service (scanned PDFs and images)
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Agent-to-Provider Mapping (OPTIONAL — defaults shown) ─
# Override which provider each agent uses.
# Options: "groq" or "gemini"
# AGENT_EXTRACTION_PROVIDER=gemini
# AGENT_DIAGNOSIS_PROVIDER=groq
# AGENT_RISK_PROVIDER=groq
# AGENT_NUTRITION_PROVIDER=gemini
# AGENT_CHAT_PROVIDER=groq

# ── Supabase (OPTIONAL — app works without it using memory)
# Create project: https://supabase.com/dashboard
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key_here

# ── Application Settings ──────────────────────────────────
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ── Security Settings ─────────────────────────────────────
# API_KEY: Set to lock down API endpoints.
# When set, all /api/* requests must include: X-API-Key: <your-key>
# Leave empty for local development.
# API_KEY=your-random-secret-key-here

# MAX_UPLOAD_MB: Maximum file upload size (default: 10 MB).
# MAX_UPLOAD_MB=10

# ── Developer / Debug Flags ───────────────────────────────
# OCR_DISABLE_TESSERACT=true  # Skip Tesseract (dev/testing only)
