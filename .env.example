# ============================================================
# Health Diagnostics AI v2.0 — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Groq LLM (REQUIRED) ───────────────────────────────────
# 1. Go to https://console.groq.com/keys
# 2. Create an API key
# 3. Paste it below
# Free tier: 30 req/min, 14,400 req/day
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── NVIDIA OCR (nemotron-ocr-v2) ──────────────────────────
# Primary OCR engine
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── OCR.space API (RECOMMENDED for image/scanned PDF) ─────
# Get free key at: https://ocr.space/ocrapi/freekey
# Free tier: 500 req/day
OCR_SPACE_API_KEY=your_ocr_space_key_here

# ── Supabase (OPTIONAL — app works without it using memory)
# Create project at: https://supabase.com/dashboard
# Find URL and key in: Settings → API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key_here

# ── Application Settings ──────────────────────────────────────
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ── Security Settings ─────────────────────────────────────────
# API_KEY: Set this on HuggingFace Spaces to lock down your API.
# When set, all /api/* requests must include: X-API-Key: <your-key>
# Leave empty for local development (guard is disabled when empty).
# API_KEY=your-random-secret-key-here

# MAX_UPLOAD_MB: Maximum allowed file upload size (default: 10 MB).
# MAX_UPLOAD_MB=10
